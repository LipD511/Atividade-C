#include <stdio.h>

int main() {
    float nota;
    float soma = 0;
    float media;
    int i;

    for (i = 1; i <= 10; i++) {
        printf("Digite a nota do cliente %d (0 a 10): ", i);
        scanf("%f", &nota);

        // Enquanto a nota for invalida, pede de novo
        while (nota < 0 || nota > 10) {
            printf("Nota invalida! Digite um valor entre 0 e 10: ");
            scanf("%f", &nota);
        }

        soma = soma + nota;  
    }

    media = soma / 10;

    printf("\nMedia geral do atendimento: %.2f\n", media);

    if (media < 7) {
        printf("Atencao: a media esta abaixo de 7! O atendimento precisa melhorar.\n");
    }

    return 0;
}