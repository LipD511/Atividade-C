#include <stdio.h>

int main() {
    int passos;         
    int total = 0;      
    int horas = 0;      

    while (total < 10000) {
        horas = horas + 1;

        printf("Passos dados na hora %d: ", horas);
        scanf("%d", &passos);

    
        while (passos < 0) {
            printf("Valor invalido! Digite um numero de passos maior ou igual a 0: ");
            scanf("%d", &passos);
        }

        total = total + passos;
        printf("Total ate agora: %d passos\n\n", total);
    }

    printf("Meta de 10000 passos atingida!\n");
    printf("Total final: %d passos\n", total);
    printf("Horas necessarias: %d\n", horas);

    return 0;
}